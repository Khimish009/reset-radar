# Stage 1 non-secret example. Wrangler uses the explicit vars in wrangler.json.
# .env is not required. No upstream, channel, resource or website is configured.
APP_ENV=local
PUBLISH_MODE=dry_run
# Future secrets belong in ignored .dev.vars* or owner-approved Cloudflare Secrets.
# Never place tokens in browser-exposed VITE_* keys.
