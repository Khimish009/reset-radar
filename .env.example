# Example non-secret local configuration only. NEVER place tokens in browser-exposed VITE_* keys.
PUBLISH_MODE=dry_run
ENABLED_SOURCES=claude,codex
CLAUDE_RESETS_BASE_URL=https://clauderesets.com
CODEX_RESET_BASE_URL=https://codexreset.ai
SOURCE_USER_AGENT=ResetRadar/0.1 (+https://github.com/REPLACE_OWNER/reset-radar)
# VERIFIED staging channel only, then separate prod env. Public handle or numeric ID.
TELEGRAM_CHANNEL_ID=@REPLACE_WITH_STAGING_CHANNEL
# bot token: must go in .dev.vars (ignored) or Cloudflare Secrets, never .env / repo
# VITE_PUBLIC_API_BASE_URL in website build is PUBLIC, not a token:
VITE_PUBLIC_API_BASE_URL=https://REPLACE_REAL_WORKER.workers.dev
# CORS configured to the actual verified GitHub Pages origin, e.g. https://OWNER.github.io
PUBLIC_SITE_ORIGIN=https://REPLACE_OWNER.github.io
